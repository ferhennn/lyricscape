# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# user-added tracks: media + extracted covers stay local to each machine.
# manifest.json and README.md are committed (manifest is regenerated by
# `npm run tracks` on every dev/build).
/public/tracks/*
!/public/tracks/README.md
!/public/tracks/manifest.json
!/public/tracks/.covers/
/public/tracks/.covers/*
!/public/tracks/.covers/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
